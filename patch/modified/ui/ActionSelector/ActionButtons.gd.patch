+# true  - this panel is alone on screen: centre its rows.
+# false - the usual two-panel layout, mirrored so each bar hugs the middle of the screen.
+func set_solo_layout(solo):
+	if solo == _solo_tuned:
+		return
+	_solo_tuned = solo
+	if solo:
+		$"%BottomRow".alignment = BoxContainer.ALIGN_CENTER
+		$"%TopRow".alignment = BoxContainer.ALIGN_CENTER
